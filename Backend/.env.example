# Copy to .env in this folder. Never commit .env.

# --- Google AI Studio (Gemini) — use this if you do NOT use OpenRouter ---
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=nothing to see here

# Model name as shown in AI Studio (not the OpenRouter slug)
# GEMINI_MODEL=gemini-2.5-flash

# --- OpenRouter (optional; Lab 5 default path when this key is set) ---
# OPENROUTER_KEY=your_openrouter_key_here
# DEFAULT_MODEL=google/gemini-2.5-flash

# If BOTH keys are set, OpenRouter is used unless you force Gemini:
# USE_DIRECT_GEMINI=true

# Cost log CSV path (relative to cwd when you start uvicorn)
# COST_LOG_PATH=logs/cost-log.csv

# --- Vision (images on /api/ai/generate and /api/ai/stream) ---
# Keep limits tight for the shared OpenRouter budget (~$30 project cap).
# MAX_VISION_IMAGES=2
# MAX_VISION_BYTES_PER_IMAGE=5242880

# Production path: unset GEMINI_API_KEY and use only OPENROUTER_KEY + a vision-capable
# DEFAULT_MODEL (e.g. google/gemini-2.5-flash). Dev: AI Studio GEMINI_API_KEY + USE_DIRECT_GEMINI=true
# avoids burning OpenRouter credits while you iterate.
