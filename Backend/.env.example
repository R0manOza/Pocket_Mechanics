# Pocket Mechanics — Backend environment template.
# Copy this file to Backend/.env (never commit Backend/.env).
# Every variable below is read by the running app; defaults shown in comments
# match the code so the app works with the minimum vars set.

# ─── LLM provider keys ──────────────────────────────────────────────────────
# At least ONE of the two below must be set.
#
# Path A — Direct Gemini (cheapest dev path, no OpenRouter spend):
#   - Set GEMINI_API_KEY (get one at https://aistudio.google.com/apikey)
#   - Optional: USE_DIRECT_GEMINI=true forces this path even if OPENROUTER_KEY is set
# Path B — OpenRouter (production default; gives access to OpenAI, Anthropic, Gemini, Llama, ...):
#   - Set OPENROUTER_KEY and DEFAULT_MODEL
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_KEY=your_openrouter_key_here
USE_DIRECT_GEMINI=false

# ─── Model selection ────────────────────────────────────────────────────────
DEFAULT_MODEL=google/gemini-2.5-flash
STREAM_MODEL=google/gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ─── OpenRouter fallback chain (Lab 8 multi-vendor) ─────────────────────────
# Comma-separated list of model slugs to try in order when the primary fails.
# Use slugs your OpenRouter account actually serves (verify against /api/v1/models).
OPENROUTER_FALLBACK_MODELS=openai/gpt-5.5,deepseek/deepseek-v4-flash
# Set to "true" to also walk the chain when a specific model was requested.
OPENROUTER_ENABLE_FALLBACK_FOR_MODEL=false

# ─── Prompt caching (Lab 8 optimisation) ────────────────────────────────────
# When true and an Anthropic OpenRouter model is in use, attaches
# {"cache_control": {"type": "ephemeral"}} to the system prompt.
ENABLE_PROMPT_CACHE=true
# When true, prepends the extended stable system prefix from services/system_prompts.py
# to maximise cache hits on long turns.
EXTENDED_SYSTEM_PROMPT=false

# ─── Resilience (Lab 7) — timeouts, retries, exponential backoff ────────────
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE_SECONDS=0.5
LLM_BACKOFF_CAP_SECONDS=8
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2
GEMINI_TIMEOUT_SECONDS=30

# ─── Vision (multimodal inputs on /api/ai/generate and /api/ai/stream) ──────
# Keep limits tight: the shared OpenRouter budget for the project is ~$30.
MAX_VISION_IMAGES=2
MAX_VISION_BYTES_PER_IMAGE=5242880

# ─── Rate limiting (chat endpoints) ─────────────────────────────────────────
# Fixed-window limiter on /api/ai/generate and /api/ai/stream. On limit, the API
# returns HTTP 429 with a `retry_after_seconds` field + Retry-After header.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Audit logs ─────────────────────────────────────────────────────────────
# Paths are resolved relative to the cwd where uvicorn starts.
COST_LOG_PATH=logs/cost-log.csv
EPISODE_LOG_PATH=logs/episode-log.csv
