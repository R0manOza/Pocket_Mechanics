# Copy to .env and fill in real values. Never commit .env.

GEMINI_API_KEY=your_google_ai_studio_key
OPENROUTER_KEY=your_openrouter_key
DEFAULT_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODELS=google/gemma-3-27b-it:free,meta-llama/llama-4-maverick:free
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2
ENABLE_PROMPT_CACHE=true

MCP_SECRET_KEY=replace_with_a_long_random_token
MCP_LOG_PATH=logs/mcp-audit.jsonl
POCKET_MECHANICS_API_URL=http://127.0.0.1:8000

FRONTEND_ORIGINS=http://localhost:5173,https://pocket-mechanics.vercel.app
