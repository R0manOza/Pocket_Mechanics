# Copy to .env.local and adjust per environment.

# Base URL of the Pocket Mechanics backend (FastAPI).
# Local dev: uvicorn main:app --port 8000 from Backend/.
VITE_API_BASE_URL=http://localhost:8000

# Optional bearer token. Leave blank for local dev until the safety-audit step lands
# (see docs/SAFETY_AUDIT_PLAN.md). In production this must match BEARER_TOKEN on the backend.
VITE_BEARER_TOKEN=
